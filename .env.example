# Environment Variables — Copy this file to .env.local and fill in your values

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate a secret: openssl rand -hex 32
AUTH_SECRET="your-nextauth-secret"
# Your app's public URL (no trailing slash)
NEXTAUTH_URL="https://your-domain.com"
AUTH_TRUST_HOST="true"

# ─── Google Drive (Service Account) ──────────────────────────────────────────
# Setup guide: https://console.cloud.google.com
# 1. Create a project, enable Drive API
# 2. Create a Service Account, download JSON key
# 3. Share a Drive folder with the service account email
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----"
GOOGLE_DRIVE_FOLDER_ID="your-google-drive-root-folder-id"

# ─── Gumlet (Video Streaming) ─────────────────────────────────────────────────
# Setup guide: https://www.gumlet.com/docs/video/
# 1. Create an account at gumlet.com
# 2. Create a Video Collection (source)
# 3. Copy API key and Collection ID from Settings
GUMLET_API_KEY="your-gumlet-api-key"
GUMLET_COLLECTION_ID="your-gumlet-collection-id"
# Leave as "play.gumlet.io" or set your custom subdomain
NEXT_PUBLIC_GUMLET_SUBDOMAIN="play.gumlet.io"

# ─── OPEN SUQ: Print-on-Demand (Prodigi Print API v4.0) ───────────────────────
# Sign up at: https://www.prodigi.com
# Obtain Sandbox/Live API key from Prodigi Dashboard -> Settings -> API Keys
PRODIGI_API_KEY="d6be6b89-10a8-43bf-b8b5-53e9070a451b"
PRODIGI_ENVIRONMENT="production" # Set to "production" when live

# ─── OPEN SUQ: Payments (Paystack Ghana Merchant Account) ─────────────────────
# Sign up at: https://paystack.com
# Obtain Test/Live keys from Paystack Dashboard -> Settings -> API Keys & Webhooks
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_MERCHANT_CURRENCY="GHS"

# ─── OPEN SUQ: Storefront Configuration ───────────────────────────────────────
NEXT_PUBLIC_STORE_NAME="Open Suq"
NEXT_PUBLIC_DEFAULT_CURRENCY="GHS"
